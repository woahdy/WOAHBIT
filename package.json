{
  "name": "woahbit",
  "version": "0.1.0",
  "description": "Bitcoin Cash + Simple Ledger Protocol Type 1 core for WOAHBIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:live-slp": "npm run build && SLP_LIVE_ACCEPTANCE=1 node --test dist/tests/live-slp-mainnet.acceptance.test.js",
    "discover:slp-utxos": "npm run build && node dist/app/discover-slp-utxos-cli.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/app/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
