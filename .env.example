# Required: BCH JSON-RPC endpoint
WOAHBIT_RPC_URL=http://127.0.0.1:8332

# Optional when your RPC endpoint requires basic authentication
WOAHBIT_RPC_USERNAME=
WOAHBIT_RPC_PASSWORD=

# Optional: RPC request timeout in milliseconds (1000-120000)
WOAHBIT_RPC_TIMEOUT_MS=15000

# Optional: hosting platforms usually inject PORT automatically
PORT=3000
